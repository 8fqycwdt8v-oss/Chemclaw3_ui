# ---------------------------------------------------------------------------
# Chemclaw3 UI server (the BFF). Copy to .env for local use.
#
# This process serves the SPA and proxies /api to the Chemclaw3 FastAPI service.
# The browser never talks to the backend directly, so there is no CORS to configure.
# ---------------------------------------------------------------------------

# Where the Chemclaw3 FastAPI service is listening.
#   local uvicorn : http://127.0.0.1:8080
#   docker compose: http://chemclaw:8080
CHEMCLAW_API_URL=http://127.0.0.1:8080

# This server.
PORT=8080
# NOTE: a 0.0.0.0 bind together with AUTH_MODE=dev is refused at startup unless
# ALLOW_INSECURE_AUTH=true is set below. Use 127.0.0.1 for ordinary local dev.
BIND_HOST=127.0.0.1
LOG_LEVEL=info
APP_VERSION=dev

# Largest request body the proxy will forward, in bytes. Mirrors the backend's own
# 4 MB cap, so an oversized attachment is refused here instead of crossing the
# internal network to be rejected there.
MAX_BODY_BYTES=4000000

# --- Authentication --------------------------------------------------------
# Three modes, differing in WHO HOLDS THE TOKEN.
#
# bff      : real Entra SSO, completed by THIS SERVER. Tokens live in a sealed,
#            httpOnly cookie and the browser never sees one, so an XSS in the SPA
#            cannot exfiltrate a bearer token. This is the recommended mode.
# msal-spa : real Entra SSO run by MSAL in the BROWSER, which keeps tokens in
#            sessionStorage. The previous behaviour, kept for deployments whose
#            app registration cannot be given a client secret.
# dev      : send no Authorization header. Matches the backend running with
#            CHEMCLAW_ENTRA_REQUIRED=false, where every request is a shared
#            `dev-user` principal with all authorization gates open.
#
# `msal` is accepted as an alias and resolves to `bff`. That is a deliberate
# change of behaviour: an existing AUTH_MODE=msal deployment moves to BFF custody
# and will REFUSE TO START until ENTRA_CLIENT_SECRET and SESSION_SECRET are set.
# To keep the previous browser-MSAL flow exactly as it was, set AUTH_MODE=msal-spa.
#
# Anything that is none of these strings is a startup error, not a fallback —
# `AUTH_MODE=MSAL` used to resolve to `dev` and boot a deployment with no sign-in.
AUTH_MODE=dev

# The two opt-outs that let an UNAUTHENTICATED UI run. Both default to false and
# both refuse by default; this mirrors the backend's CHEMCLAW_SERVICE_ALLOW_INSECURE.
#
# ALLOW_INSECURE_AUTH : lets the server boot with AUTH_MODE=dev on a non-loopback
#                       bind. Without it, that combination exits at startup.
# ALLOW_DEV_AUTH      : a BUILD-time flag (read by vite.config.ts) that lets the
#                       browser bundle contain the no-token auth provider at all.
#                       Without it, the provider is not in the bundle and dev mode
#                       throws on startup. Verified by scripts/assert-no-dev-auth.mjs.
#
# Set both only for a genuinely local or throwaway deployment.
# ALLOW_INSECURE_AUTH=true
# ALLOW_DEV_AUTH=true

# Required when AUTH_MODE is bff or msal-spa.
#
# ENTRA_CLIENT_ID is this app's OWN registration. It is NOT the API's client id,
# and note that the backend has no CHEMCLAW_ENTRA_CLIENT_ID setting at all — its
# Settings model is extra="forbid", so exporting one there aborts its startup.
#
# The registration's PLATFORM differs by mode, and getting it wrong produces a
# confusing Entra error rather than a clear one:
#   bff      -> Web, redirect URI <PUBLIC_ORIGIN>/auth/callback. Presenting a
#               client secret against a SPA-platform registration is refused with
#               AADSTS9002326.
#   msal-spa -> Single-page application, redirect URI <origin>/.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Must be the API's scope, not an App ID URI on its own and not Graph's .default.
# Requesting only openid/profile yields an ID token whose `aud` is the SPA client
# id, which the backend's audience check rejects.
#   API_SCOPE=api://<api-client-id>/Chat.Access
API_SCOPE=

# --- Required only when AUTH_MODE=bff --------------------------------------
# The client secret for the Web-platform registration above. A SPA cannot hold a
# secret, which is why browser-MSAL uses a public client; moving custody to this
# server is what makes a confidential client — and its stronger guarantees about
# a stolen authorization code — possible at all.
ENTRA_CLIENT_SECRET=

# The key the session cookie is sealed under (AES-256-GCM, via HKDF). Minimum 32
# characters; anything a person could type is guessable, and a guessable key means
# anyone can forge a session for any user.
#   openssl rand -base64 48
SESSION_SECRET=

# This deployment's browser-facing origin, scheme and host only, no trailing slash.
# Used for the OAuth redirect URI and the CSRF origin check. Optional but strongly
# recommended: without it both are derived from the client-supplied Host header,
# and a mismatch presents as an unexplained AADSTS50011.
#   PUBLIC_ORIGIN=https://chem.example.com
PUBLIC_ORIGIN=

# The identity provider's origin. Change this only for a sovereign cloud:
#   https://login.microsoftonline.us            (US Government)
#   https://login.partner.microsoftonline.cn    (China, 21Vianet)
# Must be https unless it is loopback — the client secret and the authorization
# code are both sent to it.
# ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com

# --- Streaming tuning ------------------------------------------------------
# SSE comment frames while the job stream is idle, so intermediaries with idle
# timeouts do not drop a healthy but silent stream. 0 disables.
SSE_HEARTBEAT_MS=15000

# Bounds the CONNECT phase only. An established stream is deliberately allowed to
# be silent indefinitely — a turn can legitimately run for the backend's full
# 600s wall clock without emitting a byte.
UPSTREAM_CONNECT_TIMEOUT_MS=10000
