# ---------------------------------------------------------------------------
# Chemclaw3 UI server (the BFF). Copy to .env for local use.
#
# This process serves the SPA and proxies /api to the Chemclaw3 FastAPI service.
# The browser never talks to the backend directly, so there is no CORS to configure.
# ---------------------------------------------------------------------------

# Where the Chemclaw3 FastAPI service is listening.
#   local uvicorn : http://127.0.0.1:8080
#   docker compose: http://chemclaw:8080
CHEMCLAW_API_URL=http://127.0.0.1:8080

# This server.
PORT=8080
BIND_HOST=0.0.0.0
LOG_LEVEL=info
APP_VERSION=dev

# --- Authentication --------------------------------------------------------
# dev  : send no Authorization header. Matches the backend running with
#        CHEMCLAW_ENTRA_REQUIRED=false, where every request is a shared
#        `dev-user` principal with all authorization gates open.
# msal : real Entra SSO (auth code + PKCE) in the browser.
AUTH_MODE=dev

# Required only when AUTH_MODE=msal.
#
# ENTRA_CLIENT_ID is the SPA's OWN app registration (platform: Single-page
# application). It is NOT the API's client id, and note that the backend has no
# CHEMCLAW_ENTRA_CLIENT_ID setting at all — its Settings model is extra="forbid",
# so exporting one there aborts its startup.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Must be the API's scope, not an App ID URI on its own and not Graph's .default.
# Requesting only openid/profile yields an ID token whose `aud` is the SPA client
# id, which the backend's audience check rejects.
#   API_SCOPE=api://<api-client-id>/Chat.Access
API_SCOPE=

# The app roles that may decide a knowledge proposal or cancel a durable job.
# Comma-separated, and they must be the SAME names as the backend's
# CHEMCLAW_ENTRA_PRIVILEGED_ROLES — this list only hides affordances that would
# otherwise come back 403, and the backend is what actually enforces.
#
# Leaving it empty under AUTH_MODE=msal offers the decision to nobody, which
# matches the backend: a deployment that enables identity and names no privileged
# role fails closed there too. Ignored under AUTH_MODE=dev, where the backend
# opens the gate for everyone.
#   REVIEWER_ROLES=knowledge-reviewer,process-chemist
REVIEWER_ROLES=

# --- Streaming tuning ------------------------------------------------------
# SSE comment frames while the job stream is idle, so intermediaries with idle
# timeouts do not drop a healthy but silent stream. 0 disables.
SSE_HEARTBEAT_MS=15000

# Bounds the CONNECT phase only. An established stream is deliberately allowed to
# be silent indefinitely — a turn can legitimately run for the backend's full
# 600s wall clock without emitting a byte.
UPSTREAM_CONNECT_TIMEOUT_MS=10000
