# ---------------------------------------------------------------------------
# Chemclaw3 UI server (the BFF). Copy to .env for local use.
#
# This process serves the SPA and proxies /api to the Chemclaw3 FastAPI service.
# The browser never talks to the backend directly, so there is no CORS to configure.
# ---------------------------------------------------------------------------

# Where the Chemclaw3 FastAPI service is listening.
#   local uvicorn : http://127.0.0.1:8080
#   docker compose: http://chemclaw:8080
CHEMCLAW_API_URL=http://127.0.0.1:8080

# This server.
PORT=8080
BIND_HOST=0.0.0.0
# error | warn | info | debug. Anything but `debug` emits ONE JSON OBJECT PER LINE, in the field
# names the Chemclaw service's own JsonFormatter uses (time/level/logger/message/fields), so the
# two processes' logs join. `debug` is the human-readable form, for somebody watching a terminal.
LOG_LEVEL=info
APP_VERSION=dev

# What the BROWSER records, served through /config.js — silent | error | warn | info | debug.
# Deliberately separate from LOG_LEVEL: turning this pod's logs up is not the same decision as
# turning every open tab's reporting up. A single chemist's browser can be raised to `debug`
# without a redeploy by appending `?debug=1` to the URL (and `?debug=0` puts it back).
CLIENT_LOG_LEVEL=info

# --- Authentication --------------------------------------------------------
# dev  : send no Authorization header. Matches the backend running with
#        CHEMCLAW_ENTRA_REQUIRED=false, where every request is a shared
#        `dev-user` principal with all authorization gates open.
# msal : real Entra SSO (auth code + PKCE) in the browser.
AUTH_MODE=dev

# AUTH_MODE=dev on a non-loopback bind is refused unless this says it is deliberate. There is no
# default for it anywhere in this repository, on purpose: an opt-out a launcher sets for you is
# not a record of anyone's decision.
ALLOW_INSECURE_AUTH=false

# Permit this page to be framed by any origin. Needed only by a preview host (Replit); it is its
# own switch rather than a consequence of AUTH_MODE, because dev mode — the one with no sign-in —
# is the deployment that can least afford to be clickjacked.
ALLOW_FRAMING=false

# Required only when AUTH_MODE=msal.
#
# ENTRA_CLIENT_ID is the SPA's OWN app registration (platform: Single-page
# application). It is NOT the API's client id, and note that the backend has no
# CHEMCLAW_ENTRA_CLIENT_ID setting at all — its Settings model is extra="forbid",
# so exporting one there aborts its startup.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=

# Must be the API's scope, not an App ID URI on its own and not Graph's .default.
# Requesting only openid/profile yields an ID token whose `aud` is the SPA client
# id, which the backend's audience check rejects.
#   API_SCOPE=api://<api-client-id>/Chat.Access
API_SCOPE=

# The app roles that may decide a knowledge proposal or cancel a durable job.
# Comma-separated, and they must be the SAME names as the backend's
# CHEMCLAW_ENTRA_PRIVILEGED_ROLES — this list only hides affordances that would
# otherwise come back 403, and the backend is what actually enforces.
#
# Leaving it empty under AUTH_MODE=msal offers the decision to nobody, which
# matches the backend: a deployment that enables identity and names no privileged
# role fails closed there too. Ignored under AUTH_MODE=dev, where the backend
# opens the gate for everyone.
#   REVIEWER_ROLES=knowledge-reviewer,process-chemist
REVIEWER_ROLES=

# The longest message the service will accept, in characters. Must be the SAME
# number as the backend's CHEMCLAW_SERVICE_MAX_MESSAGE_CHARS, which is tuned per
# deployment: this is what the composer's counter shows and where Send stops
# working, so a disagreement is either a message refused that the service would
# have taken, or one invited and then rejected with a 422 after the whole body
# has crossed the wire. The backend publishes no route carrying it, so like
# REVIEWER_ROLES it is told to this process rather than discovered.
#
# Unset means the backend's own default (100000), which is what the SPA falls
# back to. A value that is not a whole number of characters above zero is
# REFUSED at boot rather than clamped — 0 is not "unlimited" here, it is a
# composer that refuses every message — which is the backend's own posture for
# the same setting (gt=0).
#   MAX_MESSAGE_CHARS=250000

# --- Streaming tuning ------------------------------------------------------
# SSE comment frames while the job stream is idle, so intermediaries with idle
# timeouts do not drop a healthy but silent stream. 0 disables.
SSE_HEARTBEAT_MS=15000

# Bounds the CONNECT phase only. An established stream is deliberately allowed to
# be silent indefinitely — a turn can legitimately run for the backend's full
# 600s wall clock without emitting a byte.
UPSTREAM_CONNECT_TIMEOUT_MS=10000

# --- Limits ----------------------------------------------------------------
# How long a client may take to SEND a request. Not a response bound: a 600s turn
# and a silent job stream are unaffected. With this disabled, 129 unauthenticated
# one-byte POSTs each held one upstream socket for ever and took the whole /api
# surface offline. Must be >= 125000 while the keep-alive below is 120s.
REQUEST_TIMEOUT_MS=130000

# Upstream keep-alive sockets held at once for ORDINARY calls. The ceiling the
# timeout above bounds. Every call it carries is a round trip, so this is a burst
# ceiling rather than a residency one.
MAX_UPSTREAM_SOCKETS=512

# The SSE pool, held separately, and the number that decides how many chemists one
# UI pod carries: every socket here is held for the life of a turn or of a browser
# tab. 1024 = 200 chemists x (3 job streams + 1 turn) + headroom.
#
# They used to share one pool of 512, and 200 chemists want 600 streams — measured,
# the pod stopped answering ANY request at exactly 512 live streams, including the
# turn POST, and stayed that way until the tabs closed.
MAX_UPSTREAM_STREAM_SOCKETS=1024

# How long a request may wait for a free socket in its pool before it is refused
# with 503. Node's agent queue is otherwise unbounded and untimed, so a full pool
# does not degrade — it hangs, for as long as the sockets are held.
UPSTREAM_QUEUE_TIMEOUT_MS=10000

# Largest request body forwarded. The backend's 100k-character message cap is a
# Pydantic validator, which runs after FastAPI has buffered the whole body — this
# is the only place a body is refused before it is paid for.
MAX_BODY_BYTES=2097152
MAX_UPLOAD_BYTES=33554432

# Batches this process accepts on the unauthenticated /api/client-events sink per
# minute, whoever sends them. A browser flushes at most every 5s, so 200 chemists
# cost 2400 a minute; the old ceiling of 600 refused three in four, thinning the
# browser's record by 4x exactly when something was wrong. Scales per replica.
CLIENT_EVENTS_RATE_PER_MIN=3000
