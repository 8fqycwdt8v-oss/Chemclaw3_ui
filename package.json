{
  "name": "chemclaw3-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight React chat frontend for the Chemclaw3 agent service",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build && node scripts/compress-assets.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server.js",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:no-dev-auth": "node scripts/assert-no-dev-auth.mjs",
    "check:openapi": "node --experimental-strip-types scripts/check-openapi.mjs",
    "test:e2e:full-stack": "playwright test --config playwright.full-stack.config.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.19.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "eventsource-parser": "^3.1.0",
    "ketcher-core": "3.17.2",
    "ketcher-react": "3.17.2",
    "ketcher-standalone": "3.17.2",
    "lucide-react": "^1.34.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "sirv": "^3.0.2",
    "tailwind-merge": "^3.6.0",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^3.2.7"
  }
}
