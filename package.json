{
  "name": "chemclaw3-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight React chat frontend for the Chemclaw3 agent service",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build && node scripts/assert-no-dev-auth.mjs && node scripts/compress-client.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server.mjs",
    "smoke": "node scripts/smoke.mjs",
    "smoke:boot": "node scripts/smoke-boot.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:contract": "node --experimental-strip-types scripts/check-contract.mjs",
    "gen:contract": "python3 scripts/gen_backend_contract.py"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.1",
    "eventsource-parser": "^3.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sirv": "^3.0.2",
    "smiles-drawer": "^2.4.1",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.9.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.7"
  }
}
