{
  "name": "chemclaw3-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight React chat frontend for the Chemclaw3 agent service",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build && node scripts/compress-assets.mjs",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server.js",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "ci": "node scripts/ci.mjs",
    "ci:container": "node scripts/check-container.mjs",
    "ci:all": "npm run ci && npm run ci:container",
    "check:audit": "npm audit --omit=dev --audit-level=high",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:no-dev-auth": "node scripts/assert-no-dev-auth.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:standalone": "node scripts/check-standalone-server.mjs",
    "check:serving": "node scripts/check-serving.mjs",
    "contract:check": "node scripts/contract-check.mjs",
    "generate:api": "node scripts/generate-api.mjs",
    "generate:check": "node scripts/generate-api.mjs --check",
    "check:live-contract": "node scripts/check-live-contract.mjs",
    "check:live": "npm run smoke && npm run check:live-contract",
    "test:e2e:full-stack": "playwright test --config playwright.full-stack.config.ts",
    "test:e2e:oidc-mock": "playwright test --config playwright.oidc-mock.config.ts",
    "provision:mock-tenant": "node scripts/provision-mock-tenant.mjs",
    "test:e2e:kind": "playwright test --config playwright.kind.config.ts",
    "measure:rdkit": "node scripts/measure-rdkit-placement.mjs",
    "measure:rdkit:rangeerror": "node scripts/measure-rdkit-rangeerror.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.23.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "@tanstack/react-query": "^5.103.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "comlink": "^4.4.2",
    "events": "^3.3.0",
    "eventsource-parser": "^4.1.1",
    "immer": "^11.1.18",
    "ketcher-core": "3.18.0",
    "ketcher-react": "3.18.0",
    "ketcher-standalone": "3.18.0",
    "lucide-react": "^1.48.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "^4.0.1",
    "sirv": "^3.0.2",
    "tailwind-merge": "^3.7.0",
    "unist-util-visit": "^5.1.0",
    "valibot": "^1.5.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "culori": "^4.0.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "js-yaml": "^5.4.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
