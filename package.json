{
  "name": "chemclaw3-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight React chat frontend for the Chemclaw3 agent service",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node dist/server.js",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:openapi": "node --experimental-strip-types scripts/check-openapi.mjs"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.1",
    "@rdkit/rdkit": "^2025.3.4-1.0.0",
    "eventsource-parser": "^3.1.0",
    "ketcher-core": "3.17.2",
    "ketcher-react": "3.17.2",
    "ketcher-standalone": "3.17.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "remark-gfm": "^4.0.1",
    "sirv": "^3.0.2",
    "unist-util-visit": "^5.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "esbuild": "^0.28.0",
    "happy-dom": "^15.11.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^8.1.5",
    "vitest": "^3.2.7"
  }
}
