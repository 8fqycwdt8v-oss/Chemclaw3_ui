{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true
  },
  // `vitest.config.ts` is deliberately absent: vitest bundles its own copy of vite, and its
  // `Plugin` type is structurally incompatible with vite 8's (rollup vs rolldown plugin context).
  // Including it buys nothing but a cast that would hide a genuine version skew if one ever
  // mattered. Everything else that ships TypeScript is checked.
  "include": [
    "src",
    "server",
    "shared",
    "tests",
    "e2e",
    "scripts",
    "vite.config.ts",
    "playwright.config.ts"
  ]
}
